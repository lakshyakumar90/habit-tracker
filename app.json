{
  "expo": {
    "name": "habit-tracker",
    "slug": "habit-tracker",
    "version": "1.0.0",
    "platforms": ["android", "web"],
    "orientation": "portrait",
    "icon": "./assets/images/habitly-app-icon.png",
    "scheme": "habittracker",
    "userInterfaceStyle": "light",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#D7C9FF",
        "foregroundImage": "./assets/images/habitly-mark.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.lakshya.kumar.habittracker"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/habitly-app-icon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "defaultChannel": "habitly-reminders"
        }
      ],
      [
        "expo-router",
        {
          "root": "src/app"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F6FA",
          "image": "./assets/images/habitly-mark.png",
          "imageWidth": 96
        }
      ],
      "expo-sqlite",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "root": "src/app"
      },
      "eas": {
        "projectId": "61570520-8743-4ac3-9458-b50b4f57c950"
      }
    },
    "owner": "lakshya.kumar"
  }
}
